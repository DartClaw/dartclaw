# Temp files
.agent_temp/
.deslop/

# Review files: process output, always date-stamped. The date anchor is what
# separates them from canonical story specs, which live in the same directory
# and may legitimately be named "*review*" (e.g. s20-review-grammar-...).
dev/bundle/docs/specs/**/*-review*-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.md

# Per-checkout workflow continuity
dev/state/STATE.local.md

# Dart
.dart_tool/
.dart-tool/
build/
*.g.dart
pubspec.lock
!/pubspec.lock
!/dev/tools/mascot_favicon/pubspec.lock

# IDE
.idea/
*.iml
.vscode/

# Claude Code (local instructions symlinked from dartclaw-private)
CLAUDE.local.md
.claude/worktrees/
.claude/scheduled_tasks.lock

# OS
.DS_Store

# Secrets and credentials (defense-in-depth)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
service-account*.json

# Runtime data dirs (created by local configs)
.dartclaw-example/
.dartclaw-dev-test-*/
dev/tools/dartclaw-workflows/.cache/
dev/tools/dartclaw-workflows/.data/
# Workflows test profile runtime data (materialized skills, markers, workspace
# output). Curated seed files already tracked under this dir stay tracked.
dev/testing/profiles/workflows/data/
storages
statics

# Temp files generated by tests
.agents/skills/dartclaw-*
.claude/skills/dartclaw-*
notes/
examples/sdk/*/.dartclaw-sdk-example/

# Generated embedded asset libraries — emitted by dev/tools/embed_assets.dart.
# Not committed: they are large, churn on every template/skill edit, and go
# stale silently. CI and dev/tools/build.sh generate them; run the generator
# once after cloning (see dev/guidelines/KEY_DEVELOPMENT_COMMANDS.md).
packages/dartclaw_runtime/lib/src/generated/embedded_assets.g.dart
packages/dartclaw_workflow/lib/src/generated/embedded_assets.g.dart

# Served design-system stylesheets — copied from dev/design-system/ by the same
# generator. Canonical content lives there; committing a second copy is what
# made drift possible in the first place.
packages/dartclaw_runtime/lib/src/static/tokens.css
packages/dartclaw_runtime/lib/src/static/design-system.css
packages/dartclaw_runtime/lib/src/static/icons.css
